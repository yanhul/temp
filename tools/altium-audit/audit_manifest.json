{
  "kit_version": "2.1",
  "parser": {
    "package": "altium-monkey",
    "minimum_version": "2026.9.12"
  },
  "required_inputs": [
    "*.SchDoc",
    "*.PcbDoc"
  ],
  "optional_inputs": [
    "*.PrjPcb"
  ],
  "gates": [
    "G0_INTAKE",
    "G1_PARSE",
    "G2_COMPILE",
    "G2_SCHEMATIC",
    "G3_CONNECTIVITY",
    "G4_PCB",
    "G5_ELECTRICAL",
    "G6_PHYSICAL",
    "G6_PLACEMENT",
    "G7_ROUTING",
    "G7_FUNCTIONAL",
    "G8_REPORT"
  ],
  "statuses": [
    "PASS",
    "PARTIAL",
    "BLOCKED",
    "FAIL",
    "UNKNOWN",
    "WARN"
  ],
  "evidence_labels": [
    "FACT",
    "VERIFIED",
    "INFERRED",
    "ASSUMPTION"
  ],
  "rule": "Parser/compile success alone never implies design PASS; unsupported required evidence remains PARTIAL/BLOCKED.",
  "baseline": "Two-file SCH+PCB audit is mandatory; PrjPcb only upgrades project-rule evidence.",
  "architecture": [
    "kit",
    "project_config",
    "ci_adapter"
  ],
  "required_project_config": "altium-audit.config.json",
  "workflow_template": "tools/altium-audit/workflow-template.yml",
  "runbook": "tools/altium-audit/REUSE_RUNBOOK.md",
  "industrial_rule_authority": {
    "required": true,
    "module": "industrial_rules.py",
    "normative_baseline": [
      "IPC-2221C",
      "IPC-2222",
      "IPC-7352",
      "IPC-2152",
      "IPC-6012F",
      "IPC-A-610J",
      "IPC-J-STD-001J"
    ],
    "numeric_defaults": false,
    "missing_authority_status": "BLOCKED",
    "placement_rule_domains": [
      "component_clearance",
      "board_edge_clearance",
      "courtyard",
      "keepout",
      "assembly_access"
    ],
    "routing_rule_domains": [
      "trace_width",
      "trace_clearance",
      "via_rules",
      "layer_stack",
      "current_capacity"
    ]
  },
  "schematic_semantic_authority": {
    "required": true,
    "module": "schematic_semantics.py",
    "checks": [
      "component identity",
      "designator uniqueness",
      "value/footprint/library identity",
      "compiled pin identity and pin type",
      "pin-to-net uniqueness",
      "multiple-driver conflicts",
      "single-terminal intent",
      "functional intent authority"
    ],
    "missing_functional_intent_status": "BLOCKED",
    "parser_success_is_not_authority": true
  }
}
